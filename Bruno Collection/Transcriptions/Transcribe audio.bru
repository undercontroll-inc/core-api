meta {
  name: Transcribe audio
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/v1/api/transcriptions
  body: multipartForm
  auth: inherit
}

body:multipart-form {
  audio: @file(note.webm)
}

docs {
  multipart field audio (webm/ogg/wav/mp3/m4a, max 8MB). The format is detected from the file bytes;
  a Content-Type that contradicts the content, unrecognized content or WAV longer than 180s returns 400.
}
