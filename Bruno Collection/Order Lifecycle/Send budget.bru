meta {
  name: Send budget
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/v1/api/orders/{{orderId}}/budget/send
  body: none
  auth: inherit
}

docs {
  RECEIVED → AWAITING_APPROVAL with a budget snapshot. Returns trackingUrl + whatsappText (pt-BR) + order. 400 ORDER_BUDGET_EMPTY when the total is 0.
}
