meta {
  name: List conversations
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/v1/api/chats/conversations
  body: none
  auth: inherit
}

params:query {
  limit: 20
  ~cursor: {{chatCursor}}
}

docs {
  Most recent activity first. Keyset pagination: pass nextCursor as cursor. limit 1-50 (default 20).
}
