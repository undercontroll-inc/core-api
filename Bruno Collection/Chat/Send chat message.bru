meta {
  name: Send chat message
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/v1/api/chats/messages
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
{
  "content": "{{chatContent}}"
}
}

docs {
  Response {content, state: completed | partial, reason}. partial means the reply was cut (e.g. max_tokens) and is not stored in memory.
}
