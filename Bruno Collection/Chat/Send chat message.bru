meta {
  name: Send chat message
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/v1/api/chats/messages
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
{
  "content": "{{chatContent}}",
  "conversationId": "{{conversationId}}"
}
}

docs {
  Body conversationId is optional ([A-Za-z0-9_-]{1,64}, default "default").
  Response {conversationId, content, state: completed | partial, reason}.
  409 CHAT_CONVERSATION_BUSY while another message of the same conversation is being answered.
  partial means the reply was cut (e.g. max_tokens) and is not stored in memory.
}
