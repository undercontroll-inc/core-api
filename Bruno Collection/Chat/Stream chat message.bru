meta {
  name: Stream chat message
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/v1/api/chats/messages/stream
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Accept: text/event-stream, application/json
}

body:json {
{
  "content": "{{chatContent}}"
}
}

docs {
  SSE events: start {conversationId}, status {phase}, delta {content}, then exactly one terminal event:
  - done {state: completed, content}
  - partial {state: partial, content, reason (max_tokens | interrupted | ...), retryable}
  - error {state: failed, code, message, retryable}
  Partial or failed replies are not stored in Ana's memory. Disconnecting cancels generation.
}
