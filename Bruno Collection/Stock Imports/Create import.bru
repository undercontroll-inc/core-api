meta {
  name: Create import
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/v1/api/stock-imports
  body: json
  auth: inherit
}

body:json {
  {
    "uploadId": "{{uploadId}}"
  }
}

docs {
  Step 3, after the PUT: creates the import from the uploaded file (idempotent per uploadId). Returns 202 PROCESSING; poll Get import. 400 STOCK_IMPORT_INVALID when the file was not uploaded, expired or does not match the declared type.
}
