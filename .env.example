# =============================================================================
# Undercontroll API — Environment Variables Template
# Copy this file to .env and fill in the values for your environment.
# NEVER commit the .env file to version control.
#
# Production recommendation: use AWS Secrets Manager, HashiCorp Vault,
# or your cloud provider's secret management service instead of a .env file.
# =============================================================================

# ── Active Spring Profile ────────────────────────────────────────────────────
# Options: dev | prod
SPRING_PROFILES_ACTIVE=dev

# ── Database ─────────────────────────────────────────────────────────────────
# dev defaults match docker compose (postgres:16 on localhost:5432)
DB_URL=jdbc:postgresql://localhost:5432/undercontroll
DB_DRIVER=org.postgresql.Driver
DB_USERNAME=undercontroll
DB_PASSWORD=undercontroll

# ── RabbitMQ ─────────────────────────────────────────────────────────────────
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=rabbitmq
RABBITMQ_PASSWORD=your_rabbitmq_password

# ── Mail (SMTP) ───────────────────────────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate a strong secret (≥ 256 bits). Example command:
#   openssl rand -base64 64
JWT_SECRET=REPLACE_WITH_A_STRONG_RANDOM_SECRET_OF_AT_LEAST_256_BITS

# ── Rate Limiting ─────────────────────────────────────────────────────────────
# Max authentication attempts per minute per IP (brute-force protection)
RATE_LIMIT_AUTH_RPM=10
# Max requests per minute per IP for all other endpoints
RATE_LIMIT_GENERAL_RPM=100
# Max requests per minute per IP for the customer page (/p/**) and /v1/public/**
RATE_LIMIT_PUBLIC_RPM=30

# ── Object storage (S3 in prod, MinIO from docker compose in dev) ─────────────
# dev: the defaults already point at MinIO (http://localhost:9000, minioadmin).
# STORAGE_PUBLIC_ENDPOINT is the host clients use; it is part of the URL signature.
# To open photos/uploads from a phone on the same Wi-Fi use the machine LAN IP (ipconfig getifaddr en0).
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_REGION=us-east-1
S3_UPLOAD_BUCKET=undercontroll-uploads
S3_EXPORT_BUCKET=undercontroll-exports
# prod: leave STORAGE_ENDPOINT/STORAGE_PUBLIC_ENDPOINT empty for AWS; leave the keys empty to use the IAM role.
# STORAGE_SSE=true

# ── Shop and customer page ───────────────────────────────────────────────────
# Base of the tracking link sent on WhatsApp ({PUBLIC_BASE_URL}/p/{token}).
PUBLIC_BASE_URL=http://localhost:8080
SHOP_NAME=Assistência Técnica
SHOP_PHONE=
# Digits only, with country and area code (e.g. 5511999990000). Falls back to SHOP_PHONE.
SHOP_WHATSAPP=
SHOP_ADDRESS=
SHOP_HOURS=
SHOP_WARRANTY_DAYS=90


# ── AI (per feature: none | openai | gemini) ─────────────────────────────────
# ANA_PROVIDER, TRANSCRIPTION_PROVIDER, STOCK_IMPORT_PROVIDER and LABEL_READING_PROVIDER fall back to INSIGHTS_PROVIDER.
INSIGHTS_PROVIDER=none
ANA_PROVIDER=
TRANSCRIPTION_PROVIDER=
STOCK_IMPORT_PROVIDER=
LABEL_READING_PROVIDER=
# Use a model of the selected provider (e.g. gpt-4.1-mini / whisper-1 for openai)
INSIGHTS_MODEL=gemini-3.6-flash
ANA_MODEL=gemini-3.6-flash
TRANSCRIPTION_MODEL=gemini-3.5-flash-lite
STOCK_IMPORT_MODEL=gemini-3.6-flash
LABEL_READING_MODEL=gemini-3.6-flash
# Thinking: default | off | minimal | low | high (validated against the model at startup)
INSIGHTS_THINKING=low
ANA_THINKING=default
TRANSCRIPTION_THINKING=minimal
GEMINI_API_KEY=
OPENAI_API_KEY=
INSIGHTS_TIMEOUT=60s

# ── Insight jobs (driven by the ETL publication, not by a cron) ──────────────
# The poller checks vw_market_published_snapshot and enqueues one job per snapshot;
# the worker leases due jobs. The job deadline bounds model calls and retries.
INSIGHTS_POLL_INTERVAL=5m
INSIGHTS_WORKER_INTERVAL=30s
INSIGHTS_JOB_DEADLINE=5m

# ── Live AI smoke suite (only for ./mvnw -Plive-ai verify; real, billed calls) ─
LIVE_AI_PROVIDER=gemini
LIVE_AI_MODEL=

# ── Dev seed ─────────────────────────────────────────────────────────────────
# Password for the users created by DataInitializer (dev profile only). Seed is skipped when empty.
DEV_SEED_PASSWORD=
