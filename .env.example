# =============================================================================
# Undercontroll API — Environment Variables Template
# Copy this file to .env and fill in the values for your environment.
# NEVER commit the .env file to version control.
#
# Production recommendation: use AWS Secrets Manager, HashiCorp Vault,
# or your cloud provider's secret management service instead of a .env file.
# =============================================================================

# ── Active Spring Profile ────────────────────────────────────────────────────
# Options: dev | prod
SPRING_PROFILES_ACTIVE=dev

# ── Database ─────────────────────────────────────────────────────────────────
DB_URL=jdbc:mysql://localhost:3306/undercontroll?useSSL=true&requireSSL=true&verifyServerCertificate=true&serverTimezone=UTC
DB_DRIVER=com.mysql.cj.jdbc.Driver
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password

# ── RabbitMQ ─────────────────────────────────────────────────────────────────
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=rabbitmq
RABBITMQ_PASSWORD=your_rabbitmq_password

# ── Mail (SMTP) ───────────────────────────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate a strong secret (≥ 256 bits). Example command:
#   openssl rand -base64 64
JWT_SECRET=REPLACE_WITH_A_STRONG_RANDOM_SECRET_OF_AT_LEAST_256_BITS

# ── Rate Limiting ─────────────────────────────────────────────────────────────
# Max authentication attempts per minute per IP (brute-force protection)
RATE_LIMIT_AUTH_RPM=10
# Max requests per minute per IP for all other endpoints
RATE_LIMIT_GENERAL_RPM=100


# ── AI (per feature: none | openai | gemini) ─────────────────────────────────
# ANA_PROVIDER and TRANSCRIPTION_PROVIDER fall back to INSIGHTS_PROVIDER.
INSIGHTS_PROVIDER=none
ANA_PROVIDER=
TRANSCRIPTION_PROVIDER=
# Empty model = provider default (gemini-3.6-flash / gpt-4.1-mini; transcription gemini-3.5-flash-lite / whisper-1)
INSIGHTS_MODEL=
ANA_MODEL=
TRANSCRIPTION_MODEL=
# Thinking: default | off | minimal | low | high (validated against the model at startup)
INSIGHTS_THINKING=low
ANA_THINKING=default
TRANSCRIPTION_THINKING=minimal
GEMINI_API_KEY=
OPENAI_API_KEY=

# ── Dev seed ─────────────────────────────────────────────────────────────────
# Password for the users created by DataInitializer (dev profile only). Seed is skipped when empty.
DEV_SEED_PASSWORD=
